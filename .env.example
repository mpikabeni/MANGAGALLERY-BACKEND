# --- Nexa Manga backend. Copy to .env for local use. NEVER commit the real .env file.
APP_NAME=Nexa Manga
APP_ENV=production              # use "development" locally
HOST=0.0.0.0
PORT=5000
AUTO_CREATE_TABLES=false        # true only once, to create the tables

# 48+ random characters each:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME   # postgres:// is accepted too

# Domain of the mini app (comma separated if several). Do not leave "*" in production.
CORS_ORIGINS=https://mangagalleryzone.netlify.app

# --- Telegram
TELEGRAM_BOT_TOKEN=             # from @BotFather
TELEGRAM_BOT_USERNAME=          # without @
TELEGRAM_MINI_APP_URL=https://mangagalleryzone.netlify.app
PUBLIC_BACKEND_URL=https://mangagallery-backend-8d98.onrender.com
TELEGRAM_WEBHOOK_SECRET=        # random string, required
REQUIRED_CHANNEL=@Nexa_CG       # the bot must be ADMIN of this channel

# --- Administrator (you): your numeric Telegram id (ask @userinfobot). Only this account is admin.
ADMIN_TELEGRAM_ID=
# Password login for the web admin is disabled by default. Enable only if you really need it.
ADMIN_PASSWORD_LOGIN=false
ADMIN_USERNAME=
