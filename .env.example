# --- Manga Gallery FR backend. Copy to .env for local use. NEVER commit the real .env file.
APP_ENV=production              # use "development" locally
HOST=0.0.0.0
PORT=5000

# 48+ random characters each:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME   # postgres:// is accepted too

# Domain of the mini app (comma separated if several). Do not leave "*" in production.
CORS_ORIGINS=https://mangagalleryzone.netlify.app

# --- Telegram
TELEGRAM_BOT_TOKEN=             # from @BotFather
TELEGRAM_BOT_USERNAME=          # without @
TELEGRAM_MINI_APP_URL=https://mangagalleryzone.netlify.app
PUBLIC_BACKEND_URL=https://mangagallery-backend-8d98.onrender.com
TELEGRAM_WEBHOOK_SECRET=        # any random string (Render can generate it); the server derives a Telegram-safe token from it
REQUIRED_CHANNEL=@Nexa_CG       # the bot must be ADMIN of this channel. Write "off" to disable the channel gate.
# The server registers the webhook + commands + menu button by itself at startup (default: true in production).
BOT_AUTO_SETUP=true

# --- Administrator (you): your numeric Telegram id (ask @userinfobot). Only this account is admin.
ADMIN_TELEGRAM_ID=
# Password login for the web admin is disabled by default. Enable only if you really need it.
ADMIN_PASSWORD_LOGIN=false
ADMIN_USERNAME=

# Optional: any e-mail address, lets the free MyMemory translator (French synopsis when MangaDex has none) translate 50 000
# characters / day instead of 5 000.
MYMEMORY_EMAIL=

# Hours between two automatic checks of the "Bientôt" titles (released as soon as complete in their language). 0 = off.
COMING_SOON_CHECK_HOURS=6

# --- Storage (images uploaded from the admin live in the database)
DB_CAPACITY_MB=1024          # size of your database plan (Render free = 1024): drives the storage meter and the 80 % / 95 % alerts
PAGE_MAX_WIDTH=1400          # width of stored pages in pixels (lower = lighter: 1200 is about 60 % lighter than the old 1600)
PAGE_JPEG_QUALITY=78         # 40-95 (lower = lighter)

# Compression par défaut des pages téléversées : eco (900 px) | normal (1100 px) | hd (1400 px)
PAGE_PROFILE=normal

# Chapitres convertis en même temps par le serveur (les autres attendent leur tour). 2 convient à un hébergement de 512 Mo.
IMPORT_WORKERS=2
